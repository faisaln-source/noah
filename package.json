{
  "name": "clipforge-ai",
  "version": "1.11.7",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "vite",
    "build": "vite build",
    "check": "tsc --noEmit",
    "pretest": "node scripts/test-fixture.mjs",
    "test": "node --test tests/*.test.mjs",
